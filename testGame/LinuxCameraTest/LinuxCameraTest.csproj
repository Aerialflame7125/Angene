<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<OutputType>exe</OutputType>
		<AssemblyName>Game</AssemblyName>
		<RootNamespace>Game</RootNamespace>
		<Nullable>disable</Nullable>
		<LangVersion>latest</LangVersion>

		<!-- Generate runtime config file -->
		<GenerateRuntimeConfigurationFiles>true</GenerateRuntimeConfigurationFiles>

		<!-- Copy dependencies to output -->
		<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
		<Platforms>AnyCPU;x64</Platforms>
	</PropertyGroup>

	<!-- Platform-specific defines -->
	<PropertyGroup Condition="'$(OS)' == 'Windows_NT'">
		<DefineConstants>WINDOWS</DefineConstants>
	</PropertyGroup>
	<PropertyGroup Condition="'$(OS)' != 'Windows_NT'">
		<DefineConstants>LINUX</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
	  <Reference Include="Angene">
	    <HintPath>..\..\Build\Angene\Lin\Angene.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Common">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Common.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Essentials">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Essentials.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Extensions.Input">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Extensions.Input.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Extensions.XR">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Extensions.XR.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Graphics">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Graphics.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Linux">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Linux.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Management">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Management.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Math">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Math.dll</HintPath>
	  </Reference>
	  <Reference Include="Angene.Vulkan">
	    <HintPath>..\..\Build\Angene\Lin\Angene.Vulkan.dll</HintPath>
	  </Reference>
	</ItemGroup>

</Project>
