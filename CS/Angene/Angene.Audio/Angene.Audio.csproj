<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\Angene.Common\Angene.Common.csproj" />
    <ProjectReference Include="..\Angene.Essentials\Angene.Essentials.csproj" />
    <ProjectReference Include="..\Angene.Main\Angene.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Native/win-x64/miniaudio.dll">
      <LogicalName>Angene.Audio.Native.win-x64.miniaudio.dll</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="Native/linux-x64/libminiaudio.so">
      <LogicalName>Angene.Audio.Native.linux-x64.libminiaudio.so</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
