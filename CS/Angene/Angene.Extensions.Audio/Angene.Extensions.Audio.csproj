<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Platforms>AnyCPU;x64</Platforms>
  </PropertyGroup>

  <ItemGroup Condition="'$(AngenePlatform)' == 'Windows'">
    <EmbeddedResource Include="Native/win-x64/miniaudio.dll">
      <LogicalName>Angene.Extensions.Audio.Native.win-x64.miniaudio.dll</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup Condition="'$(AngenePlatform)' == 'Linux'">
    <EmbeddedResource Include="Native/linux-x64/libminiaudio.so">
      <LogicalName>Angene.Extensions.Audio.Native.linux-x64.libminiaudio.so</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\Angene.Assets\Angene.Assets.csproj" />
    <ProjectReference Include="..\Angene.Common\Angene.Common.csproj" />
  </ItemGroup>

</Project>
